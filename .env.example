# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Groq ------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Reddit ----------------------------------------------------------------
# Create a "script" app while logged in AS THE BOT ACCOUNT:
#   https://www.reddit.com/prefs/apps -> create another app... -> script
#   redirect uri: http://localhost:8080
# client_id is the short string under the app name; secret is labelled.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=iiests_faq_bot
# If the bot account has 2FA enabled you must use "password:TOTPCODE", which
# breaks unattended runs. Keep 2FA OFF on the bot and use a long password.
REDDIT_PASSWORD=
# Reddit enforces this format. A generic UA gets throttled or blocked.
REDDIT_USER_AGENT=script:auto-mod-r-iiests:v0.1.0 (by /u/AngadBasandrai)

# --- Behaviour -------------------------------------------------------------
# true  = log the comment it WOULD post, post nothing (default, safe)
# false = actually comment on Reddit
DRY_RUN=true
LOG_LEVEL=INFO
